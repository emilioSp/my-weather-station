{
  "name": "@wx/collector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "store-measure": "node --env-file=.env --env-file=../shared/.env index.ts",
    "ble-raw": "node ble-raw.ts",
    "seed:local": "NODE_ENV=development node --env-file=.env --env-file=../shared/.env ../../node_modules/knex/bin/cli.js --knexfile ../shared/knexfile.js seed:run --specific local-measure.ts",
    "build": "tsc",
    "dev": "npm run seed:local",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:coverage": "vitest run --coverage --config vitest.config.ts",
    "docker-build-and-push": "docker buildx build --platform linux/arm64 --file Dockerfile --tag espatola/my-weather-station:latest --push ../.."
  },
  "dependencies": {
    "@stoprocent/noble": "2.8.0",
    "@wx/shared": "*",
    "knex": "3.3.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0"
  }
}
