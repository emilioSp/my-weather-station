{
  "name": "my-weather-station",
  "version": "1.0.0",
  "description": "",
  "license": "ISC",
  "author": "",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "tsc --project packages/collector/tsconfig.json && tsc --project packages/web/tsconfig.json && tsc --project packages/shared/tsconfig.json",
    "precommit": "npm run lint && npm run typecheck && npm run test:coverage",
    "build": "npm run build --workspaces --if-present",
    "dev": "npm run dev --workspaces --if-present",
    "test:unit": "npm run test:unit --workspaces --if-present",
    "test:e2e": "npm run test:e2e --workspaces --if-present",
    "test:coverage": "npm run test:coverage --workspaces --if-present",
    "supabase:start": "supabase start",
    "supabase:reset": "supabase db reset",
    "supabase:stop": "supabase stop",
    "supabase:status": "supabase status -o env"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.10",
    "@playwright/test": "1.62.1",
    "@types/istanbul-lib-coverage": "2.0.6",
    "@types/istanbul-lib-report": "3.0.3",
    "@types/istanbul-reports": "3.0.4",
    "@types/node": "26.4.1",
    "@vitest/coverage-v8": "5.0.1",
    "istanbul-lib-coverage": "3.2.2",
    "istanbul-lib-report": "3.0.1",
    "istanbul-reports": "3.2.0",
    "supabase": "2.116.0",
    "typescript": "7.0.2",
    "v8-to-istanbul": "9.3.0",
    "vitest": "5.0.1"
  },
  "allowScripts": {
    "@stoprocent/noble@2.8.0": true,
    "@stoprocent/bluetooth-hci-socket@2.3.0": true,
    "@serialport/bindings-cpp": false,
    "usb": false,
    "esbuild@0.28.2": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  }
}
