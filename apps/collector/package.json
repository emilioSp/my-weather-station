{
  "name": "@wx/collector",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "imports": {
    "#*": "./*"
  },
  "scripts": {
    "store-measure": "node --env-file=.env index.ts",
    "ble-raw": "node ble-raw.ts",
    "new:migration": "knex migrate:make -x ts",
    "migrate": "node --env-file=.env ../../node_modules/knex/bin/cli.js migrate:latest",
    "rollback": "node --env-file=.env ../../node_modules/knex/bin/cli.js migrate:rollback",
    "build": "tsc",
    "docker-build-and-push": "docker buildx build --platform linux/arm64 --file Dockerfile --tag espatola/my-weather-station:latest --push ../.."
  },
  "dependencies": {
    "@stoprocent/noble": "2.8.0",
    "@wx/shared": "*",
    "knex": "3.3.0",
    "pg": "8.23.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/node": "26.2.0",
    "@types/pg": "8.23.1"
  }
}
